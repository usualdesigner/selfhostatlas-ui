  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "SFMono-Regular",
        "monospace"
      ]
    }
  },
  "text": {
    "2xs": {
      "$type": "dimension",
      "$value": "11px"
    },
    "xs": {
      "$type": "dimension",
      "$value": "12px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "13px"
    },
    "base": {
      "$type": "dimension",
      "$value": "14px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "17px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "20px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "26px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "6px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "8px"
    },
    "full": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "space": {
    "unit": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "press": {
      "$type": "duration",
      "$value": "40ms"
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0.2,
        1
      ]
    }
  },
  "shadow": {
    "palette": {
      "$type": "shadow",
      "$value": "0 24px 48px -12px rgba(31,29,26,0.22), 0 4px 12px rgba(31,29,26,0.08)",
      "$extensions": {
        "atlas.dark": "0 24px 48px -12px rgba(0,0,0,0.65), 0 4px 12px rgba(0,0,0,0.4)"
      }
    }
  },
  "focus": {
    "ring": {
      "$type": "dimension",
      "$value": "2px"
    },
    "offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  }
}
